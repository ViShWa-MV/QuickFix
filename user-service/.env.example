# Environment variables for user-service on Render.
# On Render, set these in the service's Environment tab; never commit real values.
# For local reference: copy to .env (gitignored) and fill in.

# Port Render routes traffic to
SERVER_PORT=10000

# Supabase Postgres (session pooler). The schema name must exist in the database.
# DB_USER for the pooler looks like postgres.<project-ref>.
DB_URL=jdbc:postgresql://<supabase-pooler-host>:5432/postgres?sslmode=require&currentSchema=user_svc
DB_USER=
DB_PASSWORD=

# Secrets (no defaults: the service refuses to start without them)
JWT_SECRET=
INTERNAL_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URLs
APP_FRONTEND_URL=https://quickfix-src.vercel.app
JWT_EXPIRATION_MS=3600000
