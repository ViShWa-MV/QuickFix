# Environment variables for catalog-service on Render.
# On Render, set these in the service's Environment tab; never commit real values.
# For local reference: copy to .env (gitignored) and fill in.

# Port Render routes traffic to
SERVER_PORT=10000

# Render Postgres (the database lives in the same Render workspace and region).
# Copy the Internal Database connection values from the database's page in the Render
# dashboard. The internal host works only from Render services in the same region.
# DB_URL format: jdbc:postgresql://<internal-host>:5432/<database>
# The schema named below must exist before the first start (see the deploy notes).
DB_URL=jdbc:postgresql://<render-internal-host>:5432/quickfix?currentSchema=catalog_svc
DB_USER=
DB_PASSWORD=

# Secrets (no defaults: the service refuses to start without them)
JWT_SECRET=
INTERNAL_API_KEY=

# Public URLs
APP_FRONTEND_URL=https://quickfix-src.vercel.app

# Must be false in production: true auto-approves technician profiles
AUTO_APPROVE_TECHNICIANS=false
