# Environment variables for booking-service on Render.
# On Render, set these in the service's Environment tab; never commit real values.
# For local reference: copy to .env (gitignored) and fill in.

# Port Render routes traffic to
SERVER_PORT=10000

# Supabase Postgres (session pooler). The schema named below must exist before the
# first start: run CREATE SCHEMA in the Supabase SQL editor.
# DB_USER for the pooler looks like postgres.<project-ref>.
DB_URL=jdbc:postgresql://<supabase-pooler-host>:5432/postgres?sslmode=require&currentSchema=booking_svc
DB_USER=
DB_PASSWORD=

# Secrets (no defaults: the service refuses to start without them)
JWT_SECRET=
INTERNAL_API_KEY=

# Other services on Render (public HTTPS URLs, no trailing slash)
CATALOG_BASE_URL=https://<catalog-service>.onrender.com
USER_SERVICE_URL=https://<user-service>.onrender.com

# Public URLs
APP_FRONTEND_URL=https://quickfix-src.vercel.app
